# Copy to faults.env and edit. Lines are KEY=value.

# The name(s) people type to reach the program, comma-separated.
FAULTS_ALLOWED_HOSTS=faults.local,localhost,127.0.0.1
# Same names with https:// in front.
FAULTS_CSRF_TRUSTED_ORIGINS=https://faults.local

# Where the database, photos and secret key live. Default: the "data" folder here.
# FAULTS_DATA_DIR=C:\DamageTracker\data

# Only for trying it out on your own PC without Caddy (never on the real server):
# FAULTS_DEBUG=1
# FAULTS_HTTPS=0

# Lock an account for 15 minutes after 5 wrong passwords.
# FAULTS_LOGIN_MAX_FAILURES=5
# FAULTS_LOGIN_LOCKOUT_MINUTES=15
# Largest photo accepted, in MB (photos are shrunk to 2000 px after upload).
# FAULTS_PHOTO_MAX_MB=20
